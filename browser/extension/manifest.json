{
  "manifest_version": 3,
  "name": "GramaDrama",
  "version": "0.3.3",
  "description": "Interfejs aplikacji GramaDrama w przeglądarce: podaje jej tekst aktywnego pola i wykonuje poprawki.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GramaDrama",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png"
    },
    "default_popup": "popup.html"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
